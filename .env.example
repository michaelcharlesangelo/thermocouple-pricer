# Required - from your Supabase project: Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional. USD/EUR and USD/IDR auto-refresh already works with NO key
# needed. This one only enables auto-fetch of Platinum/Rhodium spot price -
# without it, just type today's Kitco figures into /admin manually, which
# works fine.
#
# Get a free key from Metal Sentinel on RapidAPI (one of the few free-tier
# sources that actually includes Rhodium): https://rapidapi.com/ - search
# "Metal Sentinel", subscribe to the free plan, copy your RapidAPI key here.
RHODIUM_API_KEY=
